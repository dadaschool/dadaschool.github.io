  "lines": [
    {
      "n": 1,
      "role": "B",
      "en": "Hi, you must be Ryan. Welcome!",
      "ko": "안녕하세요, 라이언 선생님이시죠? 환영해요!",
      "alt": [
        "Hello, are you Ryan? Welcome!",
        "Welcome! You must be Ryan."
      ]
    },
    {
      "n": 2,
      "role": "A",
      "en": "Yes, that's me. Nice to meet you.",
      "ko": "네, 맞아요. 만나서 반가워요."
    },
    {
      "n": 3,
      "role": "B",
      "en": "Nice to meet you too. I'm Kim Sora.",
      "ko": "저도 반가워요. 저는 김소라예요.",
      "alt": [
        "Nice to meet you. My name is Kim Sora.",
        "Good to meet you too. I'm Kim Sora."
      ]
    },
    {
      "n": 4,
      "role": "A",
      "en": "What subject do you teach?",
      "ko": "무슨 과목을 가르치세요?"
    },
    {
      "n": 5,
      "role": "B",
      "en": "I teach English. We'll work together.",
      "ko": "저는 영어를 가르쳐요. 우리 같이 일하게 될 거예요.",
      "alt": [
        "I'm an English teacher. We'll teach together.",
        "English. We'll be working together."
      ]
    },
    {
      "n": 6,
      "role": "A",
      "en": "Great! I'm happy to work with you.",
      "ko": "잘됐네요! 함께 일하게 돼서 기뻐요."
    },
    {
      "n": 7,
      "role": "B",
      "en": "Me too. This is your desk.",
      "ko": "저도요. 여기가 선생님 자리예요.",
      "alt": [
        "Same here. Your desk is right here.",
        "Me too. Here's your desk."
      ]
    }
  ],
