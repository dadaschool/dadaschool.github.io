{
  "id": "daily-checkout-1",
  "kind": "dialogue",
  "domain": "daily",
  "situation": "checkout",
  "level": 1,
  "title": {
    "ko": "마트 계산대",
    "en": "At the Checkout"
  },
  "audioRev": 3,
  "scene": {
    "ko": "마트 계산대에서 봉투를 하나 달라고 하고 카드로 계산한다."
  },
  "roles": {
    "A": {
      "ko": "계산원",
      "en": "Cashier",
      "voice": "male-2"
    },
    "B": {
      "ko": "손님(나)",
      "en": "Customer",
      "voice": "male-1",
      "learner": true
    }
  },
  "lines": [
    {
      "n": 1,
      "role": "A",
      "en": "Hi. Did you find everything okay?",
      "ko": "안녕하세요. 찾으시는 건 다 찾으셨어요?"
    },
    {
      "n": 2,
      "role": "B",
      "en": "Yes, thanks.",
      "ko": "네, 고마워요.",
      "alt": [
        "Yes, I did. Thanks.",
        "Yes, I found everything."
      ]
    },
    {
      "n": 3,
      "role": "A",
      "en": "Do you need a bag?",
      "ko": "봉투 필요하세요?"
    },
    {
      "n": 4,
      "role": "B",
      "en": "Yes, just one, please.",
      "ko": "네, 하나만 주세요.",
      "alt": [
        "One bag, please.",
        "Yes, please. Just one."
      ]
    },
    {
      "n": 5,
      "role": "A",
      "en": "Okay. That's $23.40. Cash or card?",
      "ko": "네. 23달러 40센트입니다. 현금이세요, 카드세요?"
    },
    {
      "n": 6,
      "role": "B",
      "en": "Card, please.",
      "ko": "카드로 할게요.",
      "alt": [
        "By card, please.",
        "I'll pay by card."
      ]
    },
    {
      "n": 7,
      "role": "A",
      "en": "Great. Just tap your card here. Here's your receipt.",
      "ko": "네. 여기에 카드를 대 주세요. 영수증 여기 있습니다."
    }
  ],
  "expressions": [
    {
      "en": "Did you find everything okay?",
      "ko": "찾으시는 건 다 찾으셨어요?",
      "note": "계산원이 늘 하는 인사 · Yes, thanks 로 답함",
      "fromLine": 1
    },
    {
      "en": "Do you need a bag?",
      "ko": "봉투 필요하세요?",
      "note": "필요 없으면 No, I'm fine 또는 I have one",
      "fromLine": 3
    },
    {
      "en": "Cash or card?",
      "ko": "현금이세요, 카드세요?",
      "note": "대답은 Card, please 처럼 짧게",
      "fromLine": 5
    }
  ]
}
