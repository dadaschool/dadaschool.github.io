{
  "id": "social-keep-in-touch-1",
  "kind": "dialogue",
  "domain": "social",
  "situation": "keep-in-touch",
  "level": 1,
  "title": {
    "ko": "연락처 교환 · 다시 만날 약속",
    "en": "Exchanging Contacts and Making Plans"
  },
  "audioRev": 1,
  "scene": {
    "ko": "보드게임 모임이 끝날 무렵, 이야기가 잘 통한 사람과 연락처를 주고받는다."
  },
  "roles": {
    "A": {
      "ko": "모임에서 만난 사람",
      "en": "New acquaintance",
      "voice": "male-1"
    },
    "B": {
      "ko": "모임 참가자(나)",
      "en": "Group member",
      "voice": "female-2",
      "learner": true
    }
  },
  "lines": [
    {
      "n": 1,
      "role": "B",
      "en": "It was really nice talking to you.",
      "ko": "이야기 나눠서 정말 즐거웠어요.",
      "alt": [
        "I had fun talking with you.",
        "It was great to meet you!"
      ]
    },
    {
      "n": 2,
      "role": "A",
      "en": "You too! Can I get your number?",
      "ko": "저도요! 번호 좀 알려 줄 수 있어요?"
    },
    {
      "n": 3,
      "role": "B",
      "en": "Sure. I'll type it in for you.",
      "ko": "그럼요. 제가 입력해 줄게요.",
      "alt": [
        "Of course. Let me type it in.",
        "Sure. Hand me your phone."
      ]
    },
    {
      "n": 4,
      "role": "A",
      "en": "Thanks. I'll text you so you have mine.",
      "ko": "고마워요. 제 번호도 저장되게 문자 보낼게요."
    },
    {
      "n": 5,
      "role": "B",
      "en": "Great. Let's grab coffee sometime.",
      "ko": "좋아요. 언제 커피 한잔해요.",
      "alt": [
        "Perfect. Let's get coffee sometime.",
        "Great. We should hang out again."
      ]
    },
    {
      "n": 6,
      "role": "A",
      "en": "Definitely. I'll message you this week.",
      "ko": "좋죠. 이번 주에 연락할게요."
    },
    {
      "n": 7,
      "role": "B",
      "en": "Sounds good. See you!",
      "ko": "좋아요. 또 봐요!",
      "alt": [
        "Okay. Talk soon!",
        "Great. Bye for now!"
      ]
    }
  ],
  "expressions": [
    {
      "en": "It was really nice talking to you.",
      "ko": "이야기 나눠서 정말 즐거웠어요.",
      "note": "헤어질 때 하는 인사",
      "fromLine": 1
    },
    {
      "en": "Can I get your number?",
      "ko": "번호 좀 알려 줄 수 있어요?",
      "note": "연락처를 물을 때",
      "fromLine": 2
    },
    {
      "en": "Let's grab coffee sometime.",
      "ko": "언제 커피 한잔해요.",
      "note": "grab = 가볍게 먹다 · 마시다",
      "fromLine": 5
    }
  ]
}
