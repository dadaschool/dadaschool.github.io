  "scene": {
    "ko": "축제 안내소에서 지도를 받고 퍼레이드 시간과 음식 파는 곳을 묻는다."
  },
  "roles": {
    "A": {
      "ko": "안내소 직원",
      "en": "Information booth staff",
      "voice": "male-2"
    },
    "B": {
      "ko": "방문객(나)",
      "en": "Visitor",
      "voice": "female-2",
      "learner": true
    }
  },
  "lines": [
    {
      "n": 1,
      "role": "B",
      "en": "Hi. Can I have a festival map?",
      "ko": "안녕하세요. 축제 지도 하나 받을 수 있어요?",
      "alt": [
        "Hi. Do you have a festival map?",
        "Hello. A festival map, please."
      ]
    },
    {
      "n": 2,
      "role": "A",
      "en": "Sure. Here you go.",
      "ko": "네. 여기 있어요."
    },
    {
      "n": 3,
      "role": "B",
      "en": "When does the parade start?",
      "ko": "퍼레이드는 언제 시작해요?",
      "alt": [
        "What time is the parade?",
        "What time does the parade start?"
      ]
    },
    {
      "n": 4,
      "role": "A",
      "en": "At 4, on Main Street.",
      "ko": "4시에 메인 스트리트에서요."
    },
    {
      "n": 5,
      "role": "B",
      "en": "Where can I get food?",
      "ko": "음식은 어디서 사요?",
      "alt": [
        "Where are the food stands?",
        "Where can I buy food?"
      ]
    },
    {
      "n": 6,
      "role": "A",
      "en": "The food trucks are by the river.",
      "ko": "푸드 트럭은 강가에 있어요."
    },
    {
      "n": 7,
      "role": "B",
      "en": "Great. Thank you!",
      "ko": "좋아요. 고마워요!",
      "alt": [
        "Thanks a lot!",
        "Perfect. Thanks!"
      ]
    }
  ],
  "expressions": [
    {
      "en": "Can I have a ___?",
      "ko": "___ 받을 수 있어요?",
