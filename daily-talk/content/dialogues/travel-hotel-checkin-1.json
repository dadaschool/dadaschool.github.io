{
  "id": "travel-hotel-checkin-1",
  "kind": "dialogue",
  "domain": "travel",
  "situation": "hotel-checkin",
  "level": 1,
  "title": {
    "ko": "호텔 체크인",
    "en": "Hotel Check-in"
  },
  "audioRev": 2,
  "scene": {
    "ko": "호텔 프런트에서 예약을 확인하고 방 열쇠를 받는다."
  },
  "roles": {
    "A": {
      "ko": "프런트 직원",
      "en": "Receptionist",
      "voice": "female-1"
    },
    "B": {
      "ko": "손님(나)",
      "en": "Guest",
      "voice": "male-1",
      "learner": true
    }
  },
  "lines": [
    {
      "n": 1,
      "role": "A",
      "en": "Hi, welcome. Are you checking in?",
      "ko": "안녕하세요, 어서 오세요. 체크인하시나요?"
    },
    {
      "n": 2,
      "role": "B",
      "en": "Yes. I have a reservation under Kim.",
      "ko": "네. 김으로 예약했어요.",
      "alt": [
        "Yes, I booked a room under Kim.",
        "Yes. The reservation is under Kim."
      ]
    },
    {
      "n": 3,
      "role": "A",
      "en": "Can I see your passport, please?",
      "ko": "여권 좀 보여 주시겠어요?"
    },
    {
      "n": 4,
      "role": "B",
      "en": "Sure. Here it is.",
      "ko": "네. 여기 있어요.",
      "alt": [
        "Here you are.",
        "Here you go."
      ]
    },
    {
      "n": 5,
      "role": "A",
      "en": "You're in room 507. Here's your key.",
      "ko": "507호입니다. 열쇠 여기 있습니다."
    },
    {
      "n": 6,
      "role": "B",
      "en": "Thanks. What time is breakfast?",
      "ko": "고마워요. 아침 식사는 몇 시예요?",
      "alt": [
        "Thank you. When is breakfast?",
        "Thanks. What time does breakfast start?"
      ]
    },
    {
      "n": 7,
      "role": "A",
      "en": "From 7 to 10 on the second floor.",
      "ko": "7시부터 10시까지 2층에서요."
    }
  ],
  "expressions": [
    {
      "en": "I have a reservation under ___.",
      "ko": "___(이름)으로 예약했어요.",
      "note": "under + 예약자 이름",
      "fromLine": 2
    },
    {
      "en": "What time is ___?",
      "ko": "___는 몇 시예요?",
      "note": "시간을 물을 때",
      "fromLine": 6
    }
  ]
}
