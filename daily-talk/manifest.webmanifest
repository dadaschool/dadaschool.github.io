{
  "name": "Daily Talk — 생활영어 트레이너",
  "short_name": "Daily Talk",
  "description": "듣고, 따라 말하고, 글로도 연습하는 생활영어 트레이너",
  "lang": "ko",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f5f6f9",
  "theme_color": "#1d5fa8",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "대화 듣기", "short_name": "듣기", "url": "./#listen", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "채팅으로 연습", "short_name": "채팅", "url": "./#chat", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
